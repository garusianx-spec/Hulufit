# ── Public configuration ───────────────────────────────────────────────────
# Everything here is inlined into the client bundle. Never put a secret in a
# NEXT_PUBLIC_ variable — it is shipped to every visitor.

# Origin of the HelloFit gateway. Leave empty to call the same origin.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# `live`  — sign-in goes to the gateway above.
# `mock`  — sign-in is emulated in the browser so the PWA runs with no backend.
#           Refused in a production build.
NEXT_PUBLIC_AUTH_MODE=mock

# Canonical origin. Used for metadata, the sitemap and Digital Asset Links.
NEXT_PUBLIC_SITE_URL=https://app.hellofit.ir
