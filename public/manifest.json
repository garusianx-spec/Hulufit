      "url": "/plans?tab=workout&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-workout.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "گفتگو با مشاور",
      "short_name": "مشاوره",
      "description": "چت زنده با متخصص تغذیه",
      "url": "/chat/th_1?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-chat.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/chat/th_1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "attachments",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf",
            "audio/mpeg",
            "audio/mp4",
            "audio/webm"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "related_applications": [
    {
      "platform": "play",
      "id": "app.hellofit.twa",
