# ── HTTP ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API and open a socket.
CORS_ORIGINS=http://localhost:3000,https://app.hellofit.ir

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ chars. The server refuses to boot in production without a real value.
JWT_SECRET=dev-only-change-me-in-production-0123456789
JWT_ISSUER=hellofit
ACCESS_TOKEN_TTL=15m
# How long a refresh cookie stays valid. Accepts 30s / 15m / 12h / 30d.
REFRESH_TOKEN_TTL=30d
# Leave empty for a host-only cookie. Set to `.hellofit.ir` to share the
# session across subdomains — only do that if every subdomain is trusted.
COOKIE_DOMAIN=

# ── Passwordless SMS OTP ───────────────────────────────────────────────────
# Code lifetime, in seconds. The client countdown mirrors this value.
OTP_TTL_SECONDS=120
# Earliest resend, in seconds after the previous send.
OTP_RESEND_COOLDOWN_SECONDS=120
# Wrong-code attempts before the challenge is destroyed.
OTP_MAX_ATTEMPTS=5
# 16+ chars. Salts the stored code hashes; required in production.
OTP_PEPPER=dev-only-otp-pepper-change-me

# `console` logs the code instead of sending it and is refused in production.
SMS_PROVIDER=console
SMS_API_KEY=
# Pre-approved carrier template name for transactional codes.
SMS_TEMPLATE=hellofit-otp

# ── Object storage (MinIO in dev, any S3-compatible service in prod) ───────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hellofit-media
S3_ACCESS_KEY=hellofit
S3_SECRET_KEY=hellofit-secret
# MinIO needs path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
# Public CDN in front of the bucket. Empty ⇒ always hand out presigned URLs.
CDN_BASE_URL=

# ── Limits ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=31457280
PRESIGN_TTL_SECONDS=300
