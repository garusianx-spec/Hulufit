{
  "_comment": [
    "Source of truth for the Android wrapper. `build-twa.sh` renders this into",
    "the twa-manifest.json that Bubblewrap reads, applying the host, package id,",
    "version and signing key from the environment. Edit this file; never edit the",
    "generated one, which is disposable and git-ignored."
  ],

  "packageId": "app.hellofit.twa",
  "host": "app.hellofit.ir",
  "name": "هلوفیت",
  "launcherName": "هلوفیت",

  "display": "standalone",
  "orientation": "portrait",
  "orientationLockEnabled": true,

  "themeColor": "#059669",
  "themeColorDark": "#059669",
  "navigationColor": "#FFFFFF",
  "navigationColorDark": "#FFFFFF",
  "navigationDividerColor": "#E2E8F0",
  "navigationDividerColorDark": "#E2E8F0",
  "backgroundColor": "#F8FAFC",
  "splashScreenFadeOutDuration": 300,

  "startUrl": "/?source=twa",
  "webManifestUrl": "https://app.hellofit.ir/manifest.json",
  "fullScopeUrl": "https://app.hellofit.ir/",
  "iconUrl": "https://app.hellofit.ir/icons/icon-512.png",
  "maskableIconUrl": "https://app.hellofit.ir/icons/maskable-512.png",
  "monochromeIconUrl": "https://app.hellofit.ir/icons/monochrome-512.png",

  "enableNotifications": true,
  "enableSiteSettingsShortcut": true,
  "fallbackType": "customtabs",
  "minSdkVersion": 23,

  "appVersionName": "1.0.0",
  "appVersionCode": 1,

  "signingKey": {
    "path": "./android.keystore",
    "alias": "hellofit"
  },

  "shortcuts": [
    {
      "name": "برنامه غذایی امروز",
      "shortName": "رژیم",
      "url": "/plans?tab=diet&source=shortcut",
      "chosenIconUrl": "https://app.hellofit.ir/icons/shortcut-diet.png"
    },
    {
      "name": "برنامه تمرینی",
      "shortName": "تمرین",
      "url": "/plans?tab=workout&source=shortcut",
      "chosenIconUrl": "https://app.hellofit.ir/icons/shortcut-workout.png"
    },
    {
      "name": "گفتگو با مشاور",
      "shortName": "مشاوره",
      "url": "/chat/th_1?source=shortcut",
      "chosenIconUrl": "https://app.hellofit.ir/icons/shortcut-chat.png"
    }
  ],

  "features": {
    "locationDelegation": { "enabled": false },
    "playBilling": { "enabled": false }
  },

  "generatorApp": "bubblewrap-cli",
  "alphaDependencies": { "enabled": false },
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": []
}
